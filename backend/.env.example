FLASK_ENV=development
SECRET_KEY=replace-with-random-secret
DATABASE_URL=sqlite:///mrt_app.db
FRONTEND_ORIGIN=http://localhost:5173

DATA_PROVIDER=mock
# OneMap registered account (preferred: the backend refreshes its token).
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
# Optional short-lived token instead of account credentials (expires ~3 days).
ONEMAP_TOKEN=
# Optional self-hosted/approved OSRM-compatible OSM router.
OSRM_BASE_URL=
LTA_ACCOUNT_KEY=

# Live LTA + data.gov.sg integrations. Keep "mock" for deterministic demos.
# Set DATA_PROVIDER=live and add LTA_ACCOUNT_KEY for live operational data.

AI_PROVIDER=rule_based
AI_API_KEY=
RACHEL_AI_ENABLED=false

# Web Push. Run: python scripts/generate_vapid_key.py
VAPID_PRIVATE_KEY=instance/vapid_private.pem
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:replace-with-team-contact@example.com

UPLOAD_PROVIDER=local
UPLOAD_MAX_MB=5

RATE_LIMIT_INCIDENTS=10/hour
RATE_LIMIT_AI=30/hour

AI_DAILY_CALL_CAP=900
AI_CACHE_TTL_SECONDS=900

ALERTS_CACHE_TTL_SECONDS=60
