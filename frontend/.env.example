# Base URL for the Flask backend API
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Enable mock data fallback when backend is unavailable (true/false)
VITE_ENABLE_MOCK_FALLBACK=true

# Journey Map basemap. The default is OpenFreeMap (OpenStreetMap vector tiles,
# free, no key). Override with a MapLibre style URL or an OSM-based raster
# template. The public tile.openstreetmap.org server is refused by design.
# VITE_MAP_STYLE_URL=https://your-provider.example/style.json
# VITE_MAP_TILE_URL=https://your-provider.example/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=Your provider
