# Base URL for the Flask backend API
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Enable mock data fallback when backend is unavailable (true/false)
VITE_ENABLE_MOCK_FALLBACK=true

# OSM-compatible raster tile template for the Journey Map. Configure a
# project-approved provider or self-hosted endpoint for deployed traffic.
# The default public OSM tile URL is suitable only for low-volume local demos.
# VITE_OSM_TILE_URL=https://your-provider.example/{z}/{x}/{y}.png
