# Base URL for the Flask backend API
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Enable mock data fallback when backend is unavailable (true/false)
VITE_ENABLE_MOCK_FALLBACK=true

# Optional Member 2 live journey-impact endpoint. Leave blank to use the labelled replay fixtures.
VITE_RACHEL_IMPACT_URL=

# Member 4's validated explanation endpoint (relative to VITE_API_BASE_URL).
VITE_RACHEL_EXPLANATION_URL=/assistant/explain-journey
